# Supabase > Project Settings > API. Both values are public frontend configuration.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Legacy anon public key also works via VITE_SUPABASE_ANON_KEY.
# NEVER put a service_role / sb_secret_ key or database password here.
